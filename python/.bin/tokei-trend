#!/usr/bin/env python3
"""Incrementally track tokei (LOC) stats per commit and regenerate the trend dashboard.

Snapshots each new commit via `git archive` into a scratch dir (never checks out
or touches the working tree), runs `tokei --hidden --output json` against it, and
appends the result to .tokei-trend/data.json. Re-running only processes commits
made since the last run. Then rebuilds .tokei-trend/report.html from the cached
data, ready to open in a browser.

Usage:
  tokei-trend                 # process new commits since last run (or backfill
                               # the last 3 months on first run), regenerate report
  tokei-trend --since "1 year ago"   # backfill window used only when there is no
                                      # existing data.json yet (or with --rebuild)
  tokei-trend --rebuild        # ignore existing data.json and start over
  tokei-trend --open           # open the regenerated report when done
"""

import argparse
import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

SCRIPT_PATH = Path(__file__).resolve()


def run(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def find_repo_root():
    result = run(["git", "-C", str(SCRIPT_PATH.parent), "rev-parse", "--show-toplevel"])
    if result.returncode != 0:
        sys.exit(
            "tokei-trend: not inside a git repo (looked next to "
            + str(SCRIPT_PATH)
            + ")"
        )
    return Path(result.stdout.strip())


def require_tokei():
    if shutil.which("tokei") is None:
        sys.exit("tokei-trend: `tokei` not found on PATH — brew install tokei")


def snapshot_commit(repo, snap_dir, commit_hash):
    if snap_dir.exists():
        shutil.rmtree(snap_dir)
    snap_dir.mkdir(parents=True)
    archive = subprocess.run(
        ["git", "-C", str(repo), "archive", commit_hash], capture_output=True
    ).stdout
    if not archive:
        return None
    tar_proc = subprocess.Popen(
        ["tar", "-x", "-C", str(snap_dir)], stdin=subprocess.PIPE
    )
    tar_proc.communicate(input=archive)
    tokei = run(["tokei", "--hidden", "--output", "json", str(snap_dir)])
    if tokei.returncode != 0 or not tokei.stdout.strip():
        return None
    try:
        data = json.loads(tokei.stdout)
    except json.JSONDecodeError:
        return None

    total = data.get("Total", {})
    code = total.get("code", 0)
    comments = total.get("comments", 0)
    blanks = total.get("blanks", 0)
    languages = {}
    files = 0
    for lang, v in data.items():
        if lang == "Total":
            continue
        languages[lang] = {
            "code": v.get("code", 0),
            "comments": v.get("comments", 0),
            "blanks": v.get("blanks", 0),
        }
        files += len(v.get("reports", []))

    return {
        "code": code,
        "comments": comments,
        "blanks": blanks,
        "lines": code + comments + blanks,
        "files": files,
        "languages": languages,
    }


def main():
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        "--since",
        default="3 months ago",
        help='backfill window for the first run (default: "3 months ago")',
    )
    parser.add_argument(
        "--rebuild",
        action="store_true",
        help="ignore cached data.json and backfill from scratch",
    )
    parser.add_argument(
        "--open", action="store_true", help="open the regenerated report.html when done"
    )
    args = parser.parse_args()

    require_tokei()
    repo = find_repo_root()
    out_dir = repo / ".tokei-trend"
    out_dir.mkdir(exist_ok=True)
    data_file = out_dir / "data.json"
    template_file = out_dir / "template.html"
    report_file = out_dir / "report.html"
    snap_dir = Path(tempfile.gettempdir()) / "tokei-trend-snap"

    if not template_file.exists():
        sys.exit(
            f"tokei-trend: missing {template_file} — this ships alongside the script, don't move one without the other"
        )

    records = []
    if data_file.exists() and not args.rebuild:
        records = json.loads(data_file.read_text())

    known_hashes = {r["hash"] for r in records}

    if records:
        last_hash = records[-1]["hash"]
        ancestry = run(
            ["git", "-C", str(repo), "merge-base", "--is-ancestor", last_hash, "HEAD"]
        )
        if ancestry.returncode != 0:
            sys.exit(
                f"tokei-trend: last recorded commit {last_hash[:8]} is not an ancestor of HEAD "
                "(history was rewritten?). Re-run with --rebuild to start over."
            )
        log = run(
            [
                "git",
                "-C",
                str(repo),
                "log",
                f"{last_hash}..HEAD",
                "--format=%H|%aI",
                "--reverse",
            ]
        )
    else:
        log = run(
            [
                "git",
                "-C",
                str(repo),
                "log",
                f"--since={args.since}",
                "--format=%H|%aI",
                "--reverse",
            ]
        )

    candidates = [tuple(l.split("|", 1)) for l in log.stdout.splitlines() if l.strip()]
    candidates = [(h, d) for h, d in candidates if h not in known_hashes]

    if not candidates:
        print("tokei-trend: no new commits to process")
    else:
        print(f"tokei-trend: processing {len(candidates)} new commit(s)")
        skipped = []
        for i, (h, date) in enumerate(candidates):
            stats = snapshot_commit(repo, snap_dir, h)
            if stats is None:
                skipped.append(h)
                continue
            records.append({"hash": h, "date": date, **stats})
            if (i + 1) % 25 == 0 or i + 1 == len(candidates):
                print(f"  {i + 1}/{len(candidates)}", file=sys.stderr)
        shutil.rmtree(snap_dir, ignore_errors=True)
        if skipped:
            print(
                f"tokei-trend: skipped {len(skipped)} commit(s) tokei couldn't process: "
                + ", ".join(s[:8] for s in skipped)
            )

    records.sort(key=lambda r: r["date"])
    data_file.write_text(json.dumps(records, indent=2))

    compact = json.dumps(records, separators=(",", ":"))
    html = template_file.read_text()
    assert "__DATA_JSON__" in html, (
        "template.html is missing the __DATA_JSON__ placeholder"
    )
    html = html.replace("__DATA_JSON__", compact)
    report_file.write_text(html)

    print(
        f"tokei-trend: {len(records)} commits tracked, report written to {report_file}"
    )

    if args.open:
        subprocess.run(["open", str(report_file)])


if __name__ == "__main__":
    main()
