#!/usr/bin/env bash
# TUI for managing ai/.config/mcphub/servers.json — list/add/edit/enable-disable
# MCP servers with gum, edit raw server JSON in $EDITOR, and sync native
# per-client entries to Claude Code, Cursor, and Copilot CLI after each change.
set -euo pipefail

# Resolve the real script location — invoked via the stowed symlink in
# ~/.local/bin, and BASH_SOURCE doesn't follow symlinks on its own.
resolve_script_dir() {
  local src="${BASH_SOURCE[0]}"
  while [ -h "$src" ]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")" && pwd
}

SCRIPT_DIR="$(resolve_script_dir)"
AI_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
SERVERS_JSON="$AI_DIR/.config/mcphub/servers.json"
SYNC_SCRIPT="$AI_DIR/sync-ai-config.sh"

require_commands() {
  local cmd missing=0
  for cmd in "$@"; do
    command -v "$cmd" >/dev/null 2>&1 || {
      echo "Missing dependency: $cmd" >&2
      missing=1
    }
  done
  return "$missing"
}

require_commands gum jq || exit 1
: "${EDITOR:=vi}"

readonly ANSI_GREEN=$'\033[32m'
readonly ANSI_RED=$'\033[31m'
readonly ANSI_RESET=$'\033[0m'

colorize_status() {
  # $1: "enabled" or "disabled" -> same word wrapped in green/red ANSI.
  if [[ "$1" == "enabled" ]]; then
    printf '%s%s%s' "$ANSI_GREEN" "$1" "$ANSI_RESET"
  else
    printf '%s%s%s' "$ANSI_RED" "$1" "$ANSI_RESET"
  fi
}

write_atomically() {
  printf '%s\n' "$1" >"${SERVERS_JSON}.tmp"
  mv "${SERVERS_JSON}.tmp" "$SERVERS_JSON"
}

sync_now() {
  # Deliberately not routed through `gum spin` — it clears its own rendered
  # region (including anything shown via --show-output) once the wrapped
  # command exits, so the sync output never actually stuck around long
  # enough to read. Run it directly and print the captured output instead.
  local output
  output="$("$SYNC_SCRIPT" --mcp-only 2>&1)"
  if [[ -n "$output" ]]; then
    echo "$output"
    echo
    read -n 1 -s -r -p "Press any key to continue..."
    echo
  fi
}

kind_of() {
  jq -r --arg n "$1" '
    .mcpServers[$n] as $c |
    if $c.command then "stdio"
    elif $c.url then ($c.type // "http")
    else "unknown" end' "$SERVERS_JSON"
}

status_of() {
  jq -r --arg n "$1" 'if .mcpServers[$n].disabled == true then "disabled" else "enabled" end' "$SERVERS_JSON"
}

list_rows() {
  jq -r '.mcpServers | to_entries | sort_by(.key)[] |
    "\(.key)\t\(if .value.disabled == true then "disabled" else "enabled" end)\t\(
      if .value.command then "stdio" elif .value.url then (.value.type // "http") else "unknown" end
    )"' "$SERVERS_JSON"
}

make_tmp_json() {
  # macOS/BSD mktemp only substitutes trailing X's — a template with a
  # suffix after them (e.g. "...-XXXXXX.json") isn't substituted at all,
  # so every call returns the same literal path and collides. Create the
  # unique file with X's at the end, then rename to add .json for $EDITOR's
  # syntax highlighting (safe: mktemp already reserved the unique name).
  local tmp
  tmp="$(mktemp "${TMPDIR:-/tmp}/mcp-manager-XXXXXX")"
  mv "$tmp" "$tmp.json"
  echo "$tmp.json"
}

edit_json_in_editor() {
  # Opens $2 (initial JSON content) in $EDITOR, writes the edited+validated
  # result to $1 (a temp file path), returns 1 if the result isn't valid JSON.
  local tmp="$1"
  printf '%s\n' "$2" >"$tmp"
  "$EDITOR" "$tmp"
  jq empty "$tmp" 2>/dev/null
}

edit_server() {
  local name="$1" tmp current
  tmp="$(make_tmp_json)"
  current="$(jq --arg n "$name" '.mcpServers[$n]' "$SERVERS_JSON")"
  if edit_json_in_editor "$tmp" "$current"; then
    local updated
    updated="$(jq --arg n "$name" --slurpfile cfg "$tmp" '.mcpServers[$n] = $cfg[0]' "$SERVERS_JSON")"
    write_atomically "$updated"
    sync_now
  else
    gum style --foreground 196 "Invalid JSON — edit discarded."
  fi
  rm -f "$tmp"
}

add_server() {
  local name tmp
  name="$(gum input --placeholder "server name" --header "New server name")" || return 0
  [[ -z "$name" ]] && return 0
  if jq -e --arg n "$name" '.mcpServers | has($n)' "$SERVERS_JSON" >/dev/null; then
    gum style --foreground 196 "\"$name\" already exists — edit it instead."
    return 0
  fi
  tmp="$(make_tmp_json)"
  local template='{
  "command": "npx",
  "args": ["-y", "some-mcp-server"]
}'
  if edit_json_in_editor "$tmp" "$template"; then
    local updated
    updated="$(jq --arg n "$name" --slurpfile cfg "$tmp" '.mcpServers[$n] = $cfg[0]' "$SERVERS_JSON")"
    write_atomically "$updated"
    sync_now
  else
    gum style --foreground 196 "Invalid JSON — not added."
  fi
  rm -f "$tmp"
}

toggle_server() {
  local name="$1" updated
  if [[ "$(status_of "$name")" == "disabled" ]]; then
    updated="$(jq --arg n "$name" 'del(.mcpServers[$n].disabled)' "$SERVERS_JSON")"
  else
    updated="$(jq --arg n "$name" '.mcpServers[$n].disabled = true' "$SERVERS_JSON")"
  fi
  write_atomically "$updated"
  sync_now
}

delete_server() {
  local name="$1"
  gum confirm "Delete \"$name\"?" || return 0
  write_atomically "$(jq --arg n "$name" 'del(.mcpServers[$n])' "$SERVERS_JSON")"
  sync_now
}

list_tools() {
  # Only stdio (command-based) servers are supported: we speak MCP directly
  # over the process's own stdin/stdout. Remote/url servers would need an
  # HTTP+auth handshake per server (OAuth for atlassian, bearer tokens for
  # others) which isn't worth the complexity here — use the actual client's
  # /mcp view for those.
  local name="$1"
  local kind
  kind="$(kind_of "$name")"

  if [[ "$kind" != "stdio" ]]; then
    gum style --foreground 214 "\"$name\" is a $kind server — tool listing only supports stdio (command-based) servers right now."
    read -n 1 -s -r -p "Press any key to continue..."
    echo
    return 0
  fi

  local command
  command="$(jq -r --arg n "$name" '.mcpServers[$n].command' "$SERVERS_JSON")"
  local -a args=()
  mapfile -t args < <(jq -r --arg n "$name" '.mcpServers[$n].args[]?' "$SERVERS_JSON")
  local -a env_args=()
  mapfile -t env_args < <(jq -r --arg n "$name" '.mcpServers[$n].env // {} | to_entries[] | "\(.key)=\(.value)"' "$SERVERS_JSON")

  gum style --foreground 99 "Connecting to $name..."

  # Some servers (e.g. aws-knowledge-mcp-server, a fastmcp proxy to a remote
  # HTTP endpoint) need real time to process queued requests — if stdin
  # closes (EOF) before they get to tools/list, they exit having only
  # answered initialize. A coprocess lets us hold stdin open and read
  # responses as they arrive, stopping as soon as we see the tools/list
  # reply instead of guessing a fixed sleep that'd needlessly slow down
  # every fast local server too.
  local raw="" line found=0
  local deadline=$((SECONDS + 20))
  coproc MCP_SRV { timeout 25 env "${env_args[@]}" "$command" "${args[@]}" 2>/dev/null; }
  {
    printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2024-11-05","capabilities":{},"clientInfo":{"name":"mcp-manager","version":"1.0"}}}'
    printf '%s\n' '{"jsonrpc":"2.0","method":"notifications/initialized"}'
    printf '%s\n' '{"jsonrpc":"2.0","id":2,"method":"tools/list","params":{}}'
  } >&"${MCP_SRV[1]}"

  while [ "$SECONDS" -lt "$deadline" ]; do
    if IFS= read -r -t 1 -u "${MCP_SRV[0]}" line; then
      raw+="$line"$'\n'
      if jq -e 'select(.id == 2)' >/dev/null 2>&1 <<<"$line"; then
        found=1
        break
      fi
    fi
  done
  local mcp_srv_write_fd="${MCP_SRV[1]}"
  exec {mcp_srv_write_fd}>&-
  kill "$MCP_SRV_PID" 2>/dev/null || true
  wait "$MCP_SRV_PID" 2>/dev/null || true

  local tool_tsv
  if [ "$found" = 1 ]; then
    # Some servers (e.g. aws-knowledge-mcp-server) ship multi-paragraph,
    # prompt-engineering-style descriptions with embedded newlines — collapse
    # those to spaces so each tool is really one TSV line. Full text is kept
    # here; only the picker list below shows a truncated preview.
    tool_tsv="$(jq -r '
      select(.id == 2) | .result.tools[]? |
      (.description // "" | gsub("\n"; " ") | gsub(" +"; " ")) as $d |
      "\(.name)\t\($d)"
    ' <<<"$line" 2>/dev/null)"
  fi

  if [[ -z "$tool_tsv" ]]; then
    gum style --foreground 196 "No response from \"$name\" (timed out, or it failed to start — check its command/env)."
    read -n 1 -s -r -p "Press any key to continue..."
    echo
    return 0
  fi

  local -A tool_desc=()
  local preview_rows="" tname tdesc preview
  while IFS=$'\t' read -r tname tdesc; do
    [[ -z "$tname" ]] && continue
    tool_desc["$tname"]="$tdesc"
    preview="$tdesc"
    ((${#preview} > 80)) && preview="${preview:0:80}…"
    preview_rows+="$(printf '%-30s %s' "$tname" "$preview")"$'\n'
  done <<<"$tool_tsv"

  local tchoice tpicked
  while true; do
    clear
    tchoice="$(printf '%sBack\n' "$preview_rows" |
      gum choose --height 30 --header "${#tool_desc[@]} tools exposed by $name — pick one for the full description")" || break
    [[ "$tchoice" == "Back" || -z "$tchoice" ]] && break
    tpicked="$(awk '{print $1}' <<<"$tchoice")"
    {
      echo "$tpicked"
      echo
      printf '%s\n' "${tool_desc[$tpicked]}"
    } | gum pager --soft-wrap
  done
}

server_info() {
  # Server identity/capabilities from the initialize response (effectively
  # free — we already need this handshake for anything else), plus
  # resources/prompts if — and only if — the server's own capabilities say
  # it has them, to avoid a pointless extra round-trip on tools-only servers.
  local name="$1"
  local kind
  kind="$(kind_of "$name")"

  if [[ "$kind" != "stdio" ]]; then
    gum style --foreground 214 "\"$name\" is a $kind server — server info only supports stdio (command-based) servers right now."
    read -n 1 -s -r -p "Press any key to continue..."
    echo
    return 0
  fi

  local command
  command="$(jq -r --arg n "$name" '.mcpServers[$n].command' "$SERVERS_JSON")"
  local -a args=()
  mapfile -t args < <(jq -r --arg n "$name" '.mcpServers[$n].args[]?' "$SERVERS_JSON")
  local -a env_args=()
  mapfile -t env_args < <(jq -r --arg n "$name" '.mcpServers[$n].env // {} | to_entries[] | "\(.key)=\(.value)"' "$SERVERS_JSON")

  gum style --foreground 99 "Connecting to $name..."

  local deadline=$((SECONDS + 20))
  coproc MCP_SRV { timeout 25 env "${env_args[@]}" "$command" "${args[@]}" 2>/dev/null; }

  printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2024-11-05","capabilities":{},"clientInfo":{"name":"mcp-manager","version":"1.0"}}}' >&"${MCP_SRV[1]}"

  local line init_line=""
  while [ "$SECONDS" -lt "$deadline" ]; do
    if IFS= read -r -t 1 -u "${MCP_SRV[0]}" line; then
      if jq -e 'select(.id == 1)' >/dev/null 2>&1 <<<"$line"; then
        init_line="$line"
        break
      fi
    fi
  done

  local resources_line="" prompts_line=""
  if [[ -n "$init_line" ]]; then
    printf '%s\n' '{"jsonrpc":"2.0","method":"notifications/initialized"}' >&"${MCP_SRV[1]}"

    local need_resources need_prompts
    need_resources="$(jq -r '.result.capabilities.resources != null' <<<"$init_line")"
    need_prompts="$(jq -r '.result.capabilities.prompts != null' <<<"$init_line")"
    [[ "$need_resources" == "true" ]] && printf '%s\n' '{"jsonrpc":"2.0","id":3,"method":"resources/list","params":{}}' >&"${MCP_SRV[1]}"
    [[ "$need_prompts" == "true" ]] && printf '%s\n' '{"jsonrpc":"2.0","id":4,"method":"prompts/list","params":{}}' >&"${MCP_SRV[1]}"

    while [ "$SECONDS" -lt "$deadline" ] && { [[ "$need_resources" == "true" ]] || [[ "$need_prompts" == "true" ]]; }; do
      if IFS= read -r -t 1 -u "${MCP_SRV[0]}" line; then
        if [[ "$need_resources" == "true" ]] && jq -e 'select(.id == 3)' >/dev/null 2>&1 <<<"$line"; then
          resources_line="$line"
          need_resources="false"
        elif [[ "$need_prompts" == "true" ]] && jq -e 'select(.id == 4)' >/dev/null 2>&1 <<<"$line"; then
          prompts_line="$line"
          need_prompts="false"
        fi
      fi
    done
  fi

  local mcp_srv_write_fd="${MCP_SRV[1]}"
  exec {mcp_srv_write_fd}>&-
  kill "$MCP_SRV_PID" 2>/dev/null || true
  wait "$MCP_SRV_PID" 2>/dev/null || true

  if [[ -z "$init_line" ]]; then
    gum style --foreground 196 "No response from \"$name\" (timed out, or it failed to start — check its command/env)."
    read -n 1 -s -r -p "Press any key to continue..."
    echo
    return 0
  fi

  {
    jq -r '
      .result |
      "Server:        \(.serverInfo.name // "?") \(.serverInfo.version // "")",
      "Protocol:      \(.protocolVersion // "?")",
      "Capabilities:  \([.capabilities | keys[]] | join(", "))"
    ' <<<"$init_line"
    echo

    if [[ -n "$resources_line" ]]; then
      echo "Resources ($(jq -r '.result.resources | length' <<<"$resources_line" 2>/dev/null)):"
      jq -r '.result.resources[]? | "\(.name // .uri)\t\(.description // "")"' <<<"$resources_line" 2>/dev/null |
        awk -F'\t' '{ print "  " $1; if (length($2)>0) print "    " $2 }'
      echo
    fi

    if [[ -n "$prompts_line" ]]; then
      echo "Prompts ($(jq -r '.result.prompts | length' <<<"$prompts_line" 2>/dev/null)):"
      jq -r '.result.prompts[]? | "\(.name)\t\(.description // "")"' <<<"$prompts_line" 2>/dev/null |
        awk -F'\t' '{ print "  " $1; if (length($2)>0) print "    " $2 }'
      echo
    fi
  } | gum pager --soft-wrap
}

server_menu() {
  local name="$1" choice
  while true; do
    clear
    choice="$(gum choose \
      "Edit JSON" \
      "List tools" \
      "Server info" \
      "Toggle enable/disable (currently $(colorize_status "$(status_of "$name")"))" \
      "Delete" \
      "Back" \
      --no-strip-ansi \
      --height 8 \
      --header "$name  [$(kind_of "$name")]  $(colorize_status "$(status_of "$name")")")" || return 0
    case "$choice" in
    "Edit JSON") edit_server "$name" ;;
    "List tools") list_tools "$name" ;;
    "Server info") server_info "$name" ;;
    Toggle*) toggle_server "$name" ;;
    Delete)
      delete_server "$name"
      return 0
      ;;
    *) return 0 ;;
    esac
  done
}

main_menu() {
  local rows names choice picked
  while true; do
    clear
    rows="$(list_rows)"
    names="$(awk -F'\t' -v green="$ANSI_GREEN" -v red="$ANSI_RED" -v reset="$ANSI_RESET" '
      { color = ($2 == "enabled") ? green : red
        printf "%-30s %-8s %s%s%s\n", $1, $3, color, $2, reset }' <<<"$rows")"
    choice="$(printf '%s\n+ Add server\nSync now\nQuit\n' "$names" |
      gum choose --no-strip-ansi --height 30 --header "MCP servers (ai/.config/mcphub/servers.json)")" || break
    case "$choice" in
    "+ Add server") add_server ;;
    "Sync now") sync_now ;;
    Quit | "") break ;;
    *)
      picked="$(awk '{print $1}' <<<"$choice")"
      server_menu "$picked"
      ;;
    esac
  done
}

main_menu
